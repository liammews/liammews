---
import { Image } from "astro:assets";
import Layout from "../layouts/main.astro";

interface Thing {
    name: string;
    imageUrl: string | null;
    categories: string[];
}

const projectId = import.meta.env.SANITY_PROJECT_ID || "2puhe8k9";
const dataset = import.meta.env.SANITY_DATASET || "production";
const url = new URL(
    `https://${projectId}.api.sanity.io/v2025-02-19/data/query/${dataset}`,
);
url.searchParams.set("perspective", "published");
// Things retain their original stored document type in Sanity.
url.searchParams.set(
    "query",
    `*[_type == "belonging" && !defined(retired)] | order(purchased desc) {
  name,
  "imageUrl": image.asset->url,
  "categories": coalesce(categories[]->name, [])
}`,
);

const response = await fetch(url, { signal: AbortSignal.timeout(15000) });
if (!response.ok) {
    throw new Error(`Unable to load inventory from Sanity: ${response.status}`);
}
const { result: things }: { result: Thing[] } = await response.json();
---

<Layout>
    {things.length ? (
        <ul class="inventory_list">
            {things.map((thing, index) => (
                <li class="inventory-item_wrap">
                    {thing.imageUrl && (
                        <div class="inventory-item_img-wrapper">
                            <Image
                                src={thing.imageUrl}
                                alt={thing.name}
                                loading={index < 6 ? "eager" : "lazy"}
                                class="inventory-item_img"
                                width={1200}
                                height={1200}
                            />
                        </div>
                    )}

                    <div class="inventory-item_content">
                        <p>{thing.name}</p>
                        {thing.categories.length > 0 && (
                            <p class="text-colour-secondary">
                                {thing.categories.join(", ")}
                            </p>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    ) : (
        <p>No things published yet.</p>
    )}
</Layout>

<style>
    .inventory_list {
        width: 100%;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        list-style: none;
    }

    @media (max-width: 700px) {
        .inventory_list {
            display: flex;
            flex-direction: column;
        }
    }

    .inventory-item_wrap {
        width: 100%;
    }

    .inventory-item_img-wrapper {
        background-color: var(--foreground);
        aspect-ratio: 1/1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .inventory-item_img {
        height: 100%;
        width: 100%;
    }

    .inventory-item_content {
        width: 100%;
        padding-top: 0.5rem;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
</style>
