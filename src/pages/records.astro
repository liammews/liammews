---
import { Image } from "astro:assets";
import Layout from "../layouts/sub-folder.astro";

interface RecordItem {
    title: string;
    imageUrl: string | null;
    artist: string | null;
}

const projectId = import.meta.env.SANITY_PROJECT_ID || "2puhe8k9";
const dataset = import.meta.env.SANITY_DATASET || "production";
const url = new URL(
    `https://${projectId}.api.sanity.io/v2025-02-19/data/query/${dataset}`,
);
url.searchParams.set("perspective", "published");
url.searchParams.set(
    "query",
    `*[_type == "record" && coalesce(wishlist, false) == false] | order(year desc, title asc) {
  title,
  artist,
  "imageUrl": cover.asset->url
}`,
);

const response = await fetch(url, { signal: AbortSignal.timeout(15000) });
if (!response.ok) {
    throw new Error(`Unable to load records from Sanity: ${response.status}`);
}
const { result: records }: { result: RecordItem[] } = await response.json();
---

<Layout title="Records" subtitle={`${records.length} ${records.length === 1 ? 'record' : 'records'}`}>
    {records.length ? (
        <ul class="records_list">
            {records.map((record, index) => (
                <li class="records-item_wrap">
                    {record.imageUrl && (
                        <div class="records-item_img-wrapper">
                            <Image
                                src={record.imageUrl}
                                alt={record.title}
                                loading={index < 6 ? "eager" : "lazy"}
                                class="records-item_img"
                                width={1200}
                                height={1200}
                            />
                        </div>
                    )}

                    <div class="records-item_content">
                        <p>{record.title}</p>
                        {record.artist && (
                            <p class="text-colour-secondary">
                                {record.artist}
                            </p>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    ) : (
        <p>No records published yet.</p>
    )}
</Layout>

<style>
    .records_list {
        width: 100%;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        list-style: none;
    }

    @media (max-width: 700px) {
        .records_list {
            display: flex;
            flex-direction: column;
        }
    }

    .records-item_wrap {
        width: 100%;
    }

    .records-item_img-wrapper {
        background-color: var(--foreground);
        aspect-ratio: 1/1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .records-item_img {
        height: 100%;
        width: 100%;
    }

    .records-item_content {
        width: 100%;
        padding-top: 0.5rem;
        display: block;
    }

    .records-item_content p {
        margin: 0;
    }
</style>
